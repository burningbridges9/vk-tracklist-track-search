{
  "manifest_version": 3,
  "name": "VK Tracklist Search",
  "short_name": "VK Tracklist",
  "version": "1.1.0",
  "description": "Добавляет кнопку поиска трека рядом с каждой строкой треклиста в постах VK.",
  "permissions": ["storage"],
  "host_permissions": ["https://vk.ru/*", "https://vk.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VK Tracklist Search — настройки"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://vk.ru/*", "https://vk.com/*"],
      "js": ["common.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
